{
  "preferences": {
    "warnOnUnknownField": false
  },
  "fields": [
    {
      "name": "Last Name",
      "type": "text",
      "validations": {
        "required": {
          "value": "yes",
          "invalidMessage": "Last name is required."
        }
      }
    },
    {
      "name": "First Name",
      "type": "text",
      "validations": {
        "required": {
          "value": "warning",
          "invalidMessage": "You left your first name blank. Make sure this was intentional before submitting the form."
        }
      }
    },
    {
      "name": "Middle Name",
      "type": "text"
    },
    {
      "name": "Student ID",
      "type": "text",
      "validations": {
        "required": {
          "value": "yes",
          "invalidMessage": "Your student ID is required."
        },
        "regex": {
          "value": "([0]{3})?[0-9]{6}",
          "invalidMessage": "Your 9-digit student ID is required."
        }
      }
    },
    {
      "name": "Email",
      "type": "text",
      "validations": {
        "required": {
          "value": "yes",
          "invalidMessage": "Your student email is required."
        },
        "format": {
          "value": "email",
          "invalidMessage": "You must enter a valid email address."
        }
      }
    },
    {
      "name": "Major",
      "type": "text",
      "validations": {
        "required": {
          "value": "yes",
          "invalidMessage": "Your major is required."
        },
        "allowList": {
          "value": [
            "Computer Science",
            "Computer Engineering",
            "Electrical Engineering"
          ],
          "caseSensitive": false,
          "invalidMessage": "Your major can only be 'Computer Science', 'Computer Engineering' or 'Electrical Engineering', you entered '{{fieldValue}}'"
        }
      }
    },
    {
      "name": "Degree",
      "type": "text",
      "validations": {
        "required": {
          "value": "yes",
          "invalidMessage": "Your degree is required."
        },
        "allowList": {
          "value": "Masters,Master's,MS",
          "invalidMessage": "Your degree must be Masters, you entered {{fieldValue}}"
        }
      }
    },
    {
      "name": "Campus",
      "type": "button",
      "validations": {
        "disallowList": {
          "value": "Off",
          "invalidMessage": "You must select a campus."
        },
        "allowList": {
          "value": "Knoxville",
          "invalidMessage": "Your campus must be Knoxville."
        }
      }
    },
    {
      "name": "Concentration",
      "type": "text",
      "validations": {
        "required": "no"
      }
    },
    {
      "name": "MajorCourseYear1",
      "type": "text",
      "validations": {
        "required": "yes",
        "regex": {
          "value": "20[0-9]{2}\\/[Fall|Summ|Spring]*"
        }
      }
    },
    {
      "name": "MajorCourseNamePrefix",
      "type": "text",
      "validations": {
        "required": {
          "value": "yes",
          "dependentKeys": "MajorCourseYear1"
        },
        "allowList": "ECE,COSC"
      }
    }
  ]
}
